# Final public domain. Keep algofort.com as canonical until the domain migrates.
NEXT_PUBLIC_SITE_URL=https://algofort.com
# false on a staging mirror; true on the final public site. Rebuild after changes.
NEXT_PUBLIC_SITE_INDEXABLE=true

# Keep the existing private server values in your hosting environment, never Git.
# Contact form: Firebase service account, SMTP and reCAPTCHA settings are required.
# See README.md for the full existing server configuration.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
FIREBASE_SERVICE_ACCOUNT_BASE64=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_TO=
